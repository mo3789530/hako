variable "aws_region" {
  description = "AWS Region for the Control Plane account."
  type        = string
  default     = "ap-northeast-1"
}

variable "cognito_issuer_url" {
  description = "Exact Cognito User Pool issuer URL, including the user pool ID path."
  type        = string

  validation {
    condition     = can(regex("^https://[^/]+/.+", var.cognito_issuer_url))
    error_message = "cognito_issuer_url must be the HTTPS Cognito issuer URL including the user pool path."
  }
}

variable "api_lambda_zip_path" {
  description = "Path to the Hako API Lambda ZIP generated by make build-api-lambda."
  type        = string
  default     = "../../../../../build/hako-api.zip"
}

variable "github_webhook_secret_arn" {
  description = "Optional Secrets Manager ARN holding the GitHub App webhook secret; empty disables GitHub webhook ingress."
  type        = string
  default     = ""
}

variable "tenant_github_webhook_enabled" {
  description = "Enable Tenant-owned GitHub webhook ingress after per-Tenant Webhook reader Roles are provisioned."
  type        = bool
  default     = false
}

variable "tenant_github_webhook_reader_role_arns" {
  description = "Exact operator-approved Webhook-purpose reader Role ARNs, one per enabled Tenant App."
  type        = set(string)
  default     = []
}

variable "github_broker_role_name" {
  description = "Existing Control Plane IAM role name used by the Hako GitHub Credential Broker; required when private-key reader Roles are configured."
  type        = string
  default     = ""
}

variable "tenant_github_private_key_reader_role_arns" {
  description = "Exact per-Tenant private-key-purpose reader Role ARNs assumable by the Credential Broker only."
  type        = set(string)
  default     = []
}

variable "resource_plane_health_report_secret_arns" {
  description = "Exact Resource Plane ID to HMAC Secret ARN map. Empty disables the unauthenticated-by-Cognito but HMAC-authenticated health ingress."
  type        = map(string)
  default     = {}
}

variable "resource_plane_workload_spec_secret_arns" {
  description = "Exact Resource Plane ID to dedicated execution-spec HMAC Secret ARN map. Empty keeps the internal route disabled."
  type        = map(string)
  default     = {}
}

variable "resource_plane_artifact_cleanup_secret_arns" {
  description = "Exact Resource Plane ID to dedicated Artifact cleanup HMAC Secret ARN map. Empty keeps the route and Secret reads disabled."
  type        = map(string)
  default     = {}
}

variable "resource_plane_health_report_throttle_rate" {
  description = "API Gateway requests per second for Resource Plane health reports."
  type        = number
  default     = 10
}

variable "resource_plane_health_report_throttle_burst" {
  description = "API Gateway burst capacity for Resource Plane health reports."
  type        = number
  default     = 20
}

variable "github_app_slug" {
  description = "GitHub App slug for its installation setup URL."
  type        = string
  default     = ""
}

variable "github_app_id" {
  description = "Numeric ID of the GitHub App Hako expects to verify."
  type        = number
  default     = 0
}

variable "github_app_client_id" {
  description = "OAuth client ID of the GitHub App."
  type        = string
  default     = ""
}

variable "github_app_client_secret_arn" {
  description = "Secrets Manager ARN containing the GitHub App OAuth client secret."
  type        = string
  default     = ""
}

variable "github_app_callback_url" {
  description = "HTTPS OAuth callback URL registered in the GitHub App settings."
  type        = string
  default     = ""
}

variable "github_app_setup_enabled" {
  description = "Enable tenant-scoped GitHub App Installation setup and verification."
  type        = bool
  default     = false
}

variable "api_lambda_image_uri" {
  description = "Optional immutable same-Region ECR image URI for the blue/green API Lambda candidate. Empty keeps ZIP deployment active."
  type        = string
  default     = ""
}

variable "api_lambda_image_active" {
  description = "Route API Gateway to the prepared image Lambda candidate after it has been validated."
  type        = bool
  default     = false
}

variable "default_workspace_image" {
  description = "Image identifier passed to newly created Workspaces."
  type        = string
  default     = "hako-dev:latest"
}

variable "tags" {
  description = "Additional resource tags, such as a disposable E2E run ID. Hako ownership tags are reserved."
  type        = map(string)
  default     = {}
}

variable "enable_outbox_dispatcher" {
  description = "Explicitly enable the scheduled Outbox Dispatcher after Resource Plane queues and role policies are ready."
  type        = bool
  default     = false
}

variable "enable_github_checks_delivery" {
  description = "Provision the dedicated GitHub Checks queue/DLQ and alarms after its consumer deployment is ready."
  type        = bool
  default     = false
}

variable "enable_workload_run_creation" {
  description = "Expose Workload Run creation only after the worker/runtime and result delivery are ready."
  type        = bool
  default     = false
}

variable "enable_webhook_workload_triggers" {
  description = "Create untrusted verification Jobs from opted-in repository push/pull_request events. Requires webhook processor, workload runs, Checks delivery, and Dispatcher."
  type        = bool
  default     = false
}

variable "github_checks_queue_visibility_timeout_seconds" {
  description = "Visibility timeout for GitHub Checks messages."
  type        = number
  default     = 900
}

variable "github_checks_queue_age_alarm_threshold_seconds" {
  description = "Queue age alarm threshold for GitHub Checks deliveries."
  type        = number
  default     = 300
}

variable "github_checks_queue_depth_alarm_threshold" {
  description = "Visible message count alarm threshold for GitHub Checks deliveries."
  type        = number
  default     = 100
}

variable "github_checks_alarm_actions" {
  description = "Optional SNS topic ARNs notified by GitHub Checks queue alarms."
  type        = list(string)
  default     = []
}

variable "enable_github_checks_consumer_service" {
  description = "Deploy the optional ECS/Fargate GitHub Checks consumer after explicit network, image, broker, and Secret configuration."
  type        = bool
  default     = false
}

variable "github_checks_consumer_cluster_arn" {
  description = "Pre-created ECS cluster ARN for the optional Checks consumer service."
  type        = string
  default     = ""
}

variable "github_checks_consumer_subnet_ids" {
  description = "Private subnet IDs for the optional Checks consumer service."
  type        = list(string)
  default     = []
}

variable "github_checks_consumer_security_group_ids" {
  description = "Security group IDs with restricted outbound access for the optional Checks consumer service."
  type        = list(string)
  default     = []
}

variable "github_checks_consumer_image_uri" {
  description = "ARM64 consumer image URI pinned by sha256 digest."
  type        = string
  default     = ""
}

variable "github_checks_consumer_ecr_repository_arn" {
  description = "Exact private ECR repository ARN permitted for the Checks consumer task image pull."
  type        = string
  default     = ""
}

variable "github_checks_broker_url" {
  description = "Private HTTPS URL of the GitHub Checks credential broker."
  type        = string
  default     = ""
}

variable "github_checks_broker_client_cert_secret_arn" {
  description = "Secrets Manager ARN for the mTLS client certificate PEM."
  type        = string
  default     = ""
}

variable "github_checks_broker_client_key_secret_arn" {
  description = "Secrets Manager ARN for the mTLS private key PEM."
  type        = string
  default     = ""
}

variable "github_checks_broker_ca_secret_arn" {
  description = "Secrets Manager ARN for the broker CA PEM."
  type        = string
  default     = ""
}

variable "github_checks_broker_kms_key_arn" {
  description = "Optional customer-managed KMS key ARN for mTLS Secrets."
  type        = string
  default     = ""
}

variable "github_checks_consumer_desired_count" {
  description = "Desired Fargate consumer task count."
  type        = number
  default     = 1
}

variable "github_checks_consumer_cpu" {
  description = "Fargate CPU units for each Checks consumer task."
  type        = number
  default     = 512
}

variable "github_checks_consumer_memory" {
  description = "Fargate memory MiB for each Checks consumer task."
  type        = number
  default     = 1024
}

variable "github_checks_dsql_database" {
  description = "Aurora DSQL database name used by the Checks consumer."
  type        = string
  default     = "postgres"
}

variable "dispatcher_lambda_zip_path" {
  description = "Path to the Outbox Dispatcher arm64 Lambda ZIP generated by make build-dispatcher-lambda."
  type        = string
  default     = "../../../../../build/hako-dispatcher.zip"
}

variable "enable_github_webhook_processor" {
  description = "Opt in to the scheduled GitHub webhook Installation repository event processor."
  type        = bool
  default     = false
}

variable "github_webhook_processor_lambda_zip_path" {
  description = "Path to the webhook processor Lambda ZIP generated by make build-webhook-processor-lambda."
  type        = string
  default     = "../../../../../build/hako-webhook-processor.zip"
}

variable "enable_workspace_idle_reconciler" {
  description = "Explicit opt-in for the scheduled Workspace idle-suspend reconciler Lambda."
  type        = bool
  default     = false
}

variable "workspace_idle_reconciler_lambda_zip_path" {
  description = "ARM64 ZIP generated by make build-workspace-idle-reconciler-lambda."
  type        = string
  default     = "../../../../../build/hako-workspace-idle-reconciler.zip"
}

variable "workspace_idle_reconciler_batch_size" {
  description = "Maximum Workspace idle candidates rechecked by each invocation."
  type        = number
  default     = 100
}

variable "workspace_idle_reconciler_schedule_expression" {
  description = "EventBridge rate expression for the opt-in idle reconciler."
  type        = string
  default     = "rate(1 minute)"
}

variable "resource_plane_manifest_json" {
  description = "Version 1 Resource Plane registration manifest JSON for the optional scheduled Dispatcher."
  type        = string
  default     = ""
}

variable "cognito_user_pool_id" {
  description = "ID of the Cognito User Pool used by the Control Plane."
  type        = string

  validation {
    condition     = can(regex("^[A-Za-z0-9-]+_[A-Za-z0-9]+$", var.cognito_user_pool_id))
    error_message = "cognito_user_pool_id must be a Cognito User Pool ID such as ap-northeast-1_Example123."
  }
}

variable "cognito_cli_callback_urls" {
  description = "OAuth callback URLs registered on the public Hako CLI app client."
  type        = list(string)
  default     = ["http://127.0.0.1:53682/callback"]
}
